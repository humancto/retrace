{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retrace",
  "mainBinaryName": "Retrace",
  "identifier": "com.humancto.retrace",
  "build": {
    "frontendDist": "../setup-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Ask your videos what happened. Fully local.",
    "longDescription": "Retrace indexes video on your own machine and lets you search it in plain words. Nothing leaves the machine.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
